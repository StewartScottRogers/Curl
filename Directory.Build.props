<Project>

  <!--
    Settings shared by every project in the solution. Per CLAUDE.md, project files
    carry no duplicate of anything set here.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    Strip the project-name suffix out of the default namespace. The directory is
    Curl.Core.UnitLibrary because the layout pairs it with Curl.Core.UnitTests, but
    consumers should write "using Curl.Core;" - carrying .UnitLibrary into every
    namespace would put a build-layout detail in the public API. Test projects
    land in the same namespace as the code they test, which is what you want.
  -->
  <PropertyGroup>
    <RootNamespace Condition="$(MSBuildProjectName.EndsWith('.UnitLibrary'))">$(MSBuildProjectName.Replace('.UnitLibrary', ''))</RootNamespace>
    <RootNamespace Condition="$(MSBuildProjectName.EndsWith('.UnitTests'))">$(MSBuildProjectName.Replace('.UnitTests', ''))</RootNamespace>
    <RootNamespace Condition="$(MSBuildProjectName.EndsWith('.IntegrationTests'))">$(MSBuildProjectName.Replace('.IntegrationTests', ''))</RootNamespace>
  </PropertyGroup>

  <!--
    Test projects are identified by the .UnitTests or .IntegrationTests suffixes.
    They are never packed, and they are exempt from the XML-documentation
    requirement: CS1591 on a public test class is noise, and warnings are errors
    here.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('UnitTests')) Or $(MSBuildProjectName.EndsWith('IntegrationTests'))">
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Every test project compiles the shared MSTestSettings.cs at the repository root,
    which carries the assembly-level parallelization policy MSTest's MSTEST0001
    analyzer insists on. It is linked rather than copied so the policy has one home.
    Beside it, every test project compiles the shared TestDiagnostics.cs (BL-1457,
    ADR-0417): MSTest global test hooks that write each test's START, END and SLOW:
    lines, and the helper tests use for ARRANGE, ACT, ASSERT, BYTES, DIFF and PHASE lines.
  -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('UnitTests')) Or $(MSBuildProjectName.EndsWith('IntegrationTests'))">
    <Compile Include="$(MSBuildThisFileDirectory)MSTestSettings.cs" Link="MSTestSettings.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)TestDiagnostics.cs" Link="TestDiagnostics.cs" />
  </ItemGroup>

  <!--
    Curl.Console.UnitTests references Curl.Protocol.Ssh.UnitTests, which shows it its
    internals, so it sees two copies of the linked TestDiagnostics types. CS0436 says the
    compiler uses the project's own copy - the right one - so it is not an error there.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Curl.Console.UnitTests'">
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <!--
    Production projects document every public member (CLAUDE.md) and are held to the
    trim/ahead-of-time analyzers, because Curl.Console publishes native AOT and a
    library that is not AOT-clean would only fail later, further from its cause.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('UnitTests')) And !$(MSBuildProjectName.EndsWith('IntegrationTests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    Cyclomatic complexity is enforced by the SDK's own CA1502 analyzer, which only
    reads its threshold from an AdditionalFile named CodeMetricsConfig.txt - hence
    the link rather than a property. Only production projects get it: a test method
    is allowed to be long, and CA1502 stays silent in a project that has no such
    file. The indirection through CodeMetricsConfigFile lets the coverage-auditor
    agent point a probe build at a copy with the threshold lowered to 1, which is how
    it reads the complexity of every method instead of only the ones over the gate.
  -->
  <PropertyGroup>
    <CodeMetricsConfigFile Condition="'$(CodeMetricsConfigFile)' == ''">$(MSBuildThisFileDirectory)CodeMetricsConfig.txt</CodeMetricsConfigFile>
  </PropertyGroup>

  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('UnitTests')) And !$(MSBuildProjectName.EndsWith('IntegrationTests'))">
    <AdditionalFiles Include="$(CodeMetricsConfigFile)" Visible="false" />
  </ItemGroup>

  <!--
    Native ahead-of-time is not optional in this solution, so it is checked rather than
    merely configured. IsAotCompatible is set above for every production project, which
    turns on the trim and AOT analyzers; this target makes a project that quietly turns
    it back off fail the build instead of failing much later at publish time. A new
    project inherits both without touching its own csproj.

    Test projects are exempt and must stay exempt: MSTest discovers tests by reflection,
    which is exactly what the AOT analyzers exist to forbid. Nothing in a .UnitTests
    project is published.
  -->
  <Target Name="VerifyAotCompatibility"
          BeforeTargets="Build"
          Condition="!$(MSBuildProjectName.EndsWith('UnitTests')) And !$(MSBuildProjectName.EndsWith('IntegrationTests'))">
    <Error Condition="'$(IsAotCompatible)' != 'true'"
           Text="$(MSBuildProjectName) is a production project and must be ahead-of-time compatible. It sets IsAotCompatible=$(IsAotCompatible); remove that override and let Directory.Build.props set it to true." />
  </Target>

  <!--
    Integration tests live only in Curl.<Area>.IntegrationTests projects (ADR-0421, BL-1603):
    a *.UnitTests project's own source carries no [TestCategory("Integration")] attribute,
    and every test in an *.IntegrationTests project carries one, so the fast run
    (TestCategory!=Integration) skips every Integration test and runs every unit test.
    It is a build check rather than a test because a test that reads the source touches
    the disk, which would make it an Integration test the fast run never runs.

    Only the project's own files are read: linked Compile items (MSTestSettings.cs,
    TestDiagnostics.cs, fakes linked from another project) are checked in their home
    project. An Integration attribute is a line whose first non-blank character is "[" and
    which names TestCategory("Integration"), so a mention in a /// comment does not count.
    In an *.IntegrationTests project a file passes when a class-level attribute covers it,
    or when it has at least as many Integration attributes as [TestMethod] and
    [DataTestMethod] attributes. That is a source count: a method with two Integration
    attributes could hide another with none, and that is accepted.
  -->
  <PropertyGroup>
    <_IntegrationAttributePattern>(?m)^\s*\[[^\]\r\n]*\bTestCategory\s*\(\s*"Integration"\s*\)</_IntegrationAttributePattern>
    <_ClassLevelIntegrationAttributePattern>$(_IntegrationAttributePattern)[^\r\n]*(\r?\n\s*\[[^\r\n]*)*\r?\n[ \t\w]*\bclass\b</_ClassLevelIntegrationAttributePattern>
    <_TestMethodAttributePattern>(?m)^\s*\[[^\]\r\n]*\b(TestMethod|DataTestMethod)\b</_TestMethodAttributePattern>
  </PropertyGroup>

  <Target Name="VerifyIntegrationTestPlacement"
          BeforeTargets="CoreCompile"
          Condition="$(MSBuildProjectName.EndsWith('.UnitTests')) Or $(MSBuildProjectName.EndsWith('.IntegrationTests'))">
    <PropertyGroup>
      <_IsUnitTestsProject>$(MSBuildProjectName.EndsWith('.UnitTests'))</_IsUnitTestsProject>
    </PropertyGroup>
    <ItemGroup>
      <_TestPlacementSource Include="@(Compile)" Condition="'%(Compile.Link)' == '' And Exists('%(Compile.FullPath)')" />
      <_TestPlacementSource>
        <PlacementKey>$(MSBuildProjectName)/$([System.String]::Copy('%(Identity)').Replace('\', '/'))</PlacementKey>
        <IntegrationAttributes>$([System.Text.RegularExpressions.Regex]::Matches($([System.IO.File]::ReadAllText('%(FullPath)')), '$(_IntegrationAttributePattern)').Count)</IntegrationAttributes>
        <ClassLevelIntegrationAttribute>$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '$(_ClassLevelIntegrationAttributePattern)'))</ClassLevelIntegrationAttribute>
        <TestMethodAttributes>$([System.Text.RegularExpressions.Regex]::Matches($([System.IO.File]::ReadAllText('%(FullPath)')), '$(_TestMethodAttributePattern)').Count)</TestMethodAttributes>
      </_TestPlacementSource>
    </ItemGroup>
    <Error Condition="'$(_IsUnitTestsProject)' == 'true' And '%(_TestPlacementSource.IntegrationAttributes)' != '0'"
           File="%(_TestPlacementSource.FullPath)"
           Text="%(_TestPlacementSource.PlacementKey) carries [TestCategory(&quot;Integration&quot;)], but $(MSBuildProjectName) is a unit test project. Integration tests live only in a Curl.&lt;Area&gt;.IntegrationTests project (ADR-0421); move the test there." />
    <Error Condition="'$(_IsUnitTestsProject)' != 'true' And '%(_TestPlacementSource.ClassLevelIntegrationAttribute)' != 'True' And %(_TestPlacementSource.IntegrationAttributes) &lt; %(_TestPlacementSource.TestMethodAttributes)"
           File="%(_TestPlacementSource.FullPath)"
           Text="%(_TestPlacementSource.PlacementKey) has %(_TestPlacementSource.TestMethodAttributes) test methods but only %(_TestPlacementSource.IntegrationAttributes) [TestCategory(&quot;Integration&quot;)] attributes. Every test in a *.IntegrationTests project carries the Integration category (ADR-0421)." />
  </Target>

</Project>
