<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Curl.Protocol.Ssh.UnitLibrary\Curl.Protocol.Ssh.UnitLibrary.csproj" />
  </ItemGroup>

  <!--
    The unit tests' fakes the Pageant test uses, linked rather than referenced: a
    ProjectReference to Curl.Protocol.Ssh.UnitTests would bring a second TestDiagnostics.
  -->
  <ItemGroup>
    <Compile Include="..\Curl.Protocol.Ssh.UnitTests\Fakes\InMemorySshAgent.cs" Link="Fakes\InMemorySshAgent.cs" />
    <Compile Include="..\Curl.Protocol.Ssh.UnitTests\Fakes\SshTestEncoding.cs" Link="Fakes\SshTestEncoding.cs" />
    <Compile Include="..\Curl.Protocol.Ssh.UnitTests\Fakes\TestUserKeys.cs" Link="Fakes\TestUserKeys.cs" />
  </ItemGroup>

</Project>
