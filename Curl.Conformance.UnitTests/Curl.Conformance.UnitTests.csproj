<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Curl.Conformance.Http2Server.UnitLibrary\Curl.Conformance.Http2Server.UnitLibrary.csproj" />
    <ProjectReference Include="..\Curl.Conformance.Http3Server.UnitLibrary\Curl.Conformance.Http3Server.UnitLibrary.csproj" />
    <ProjectReference Include="..\Curl.Conformance.SshServer.UnitLibrary\Curl.Conformance.SshServer.UnitLibrary.csproj" />
    <ProjectReference Include="..\Curl.Conformance.UnitLibrary\Curl.Conformance.UnitLibrary.csproj" />
    <ProjectReference Include="..\Curl.Console\Curl.Console.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="CurlTestCases\Extended\**\ext*.curltest;CurlTestCases\Original\test*.curltest;CurlTestCases\Original\COPYING;CurlTestCases\Original\certs\*;CurlTestCases\Original\data\*;CurlTestCases\Original\docs\options-in-versions;CurlTestCases\Original\docs\VERSIONS.md;CurlTestCases\Original\docs\cmdline-opts\*;CurlTestCases\Original\docs\libcurl\*;CurlTestCases\Original\docs\libcurl\opts\*;CurlTestCases\Original\include\curl\*;CurlTestCases\Original\lib\*;CurlTestCases\Original\src\*;CurlTestCases\Original\projects\OS400\ccsidcurl.c;PassingUpstreamCases.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Again beside CurlTestCases\Original, the %SRCDIR, as upstream's docs and src sit beside its tests folder, where test971.pl and test1486.pl look (BL-2865). -->
    <!-- test1165.pl reads the build files and m4 macros beside docs and src too (BL-3409). -->
    <ContentWithTargetPath Include="CurlTestCases\Original\m4\*.m4" TargetPath="CurlTestCases\m4\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ContentWithTargetPath Include="CurlTestCases\Original\configure.ac;CurlTestCases\Original\CMakeLists.txt" TargetPath="CurlTestCases\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ContentWithTargetPath Include="CurlTestCases\Original\docs\**;CurlTestCases\Original\include\**;CurlTestCases\Original\lib\**;CurlTestCases\Original\src\**;CurlTestCases\Original\projects\OS400\ccsidcurl.c" TargetPath="CurlTestCases\$([System.String]::Copy('%(RelativeDir)').Substring(22))%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Curl.WebSocket" />
  </ItemGroup>

</Project>
