<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Curl.Conformance.Http2Server.UnitLibrary\Curl.Conformance.Http2Server.UnitLibrary.csproj" />
    <ProjectReference Include="..\Curl.Conformance.Http3Server.UnitLibrary\Curl.Conformance.Http3Server.UnitLibrary.csproj" />
    <ProjectReference Include="..\Curl.Conformance.SshServer.UnitLibrary\Curl.Conformance.SshServer.UnitLibrary.csproj" />
    <ProjectReference Include="..\Curl.Conformance.UnitLibrary\Curl.Conformance.UnitLibrary.csproj" />
    <ProjectReference Include="..\Curl.Console\Curl.Console.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="UpstreamTestData\test*.curltest;UpstreamTestData\COPYING;UpstreamTestData\certs\*;UpstreamTestData\data\*;UpstreamTestData\docs\options-in-versions;UpstreamTestData\docs\VERSIONS.md;UpstreamTestData\docs\cmdline-opts\*;UpstreamTestData\docs\libcurl\*;UpstreamTestData\docs\libcurl\opts\*;UpstreamTestData\include\curl\*;UpstreamTestData\lib\*;UpstreamTestData\src\*;PassingUpstreamCases.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Again beside UpstreamTestData, the %SRCDIR, as upstream's docs and src sit beside its tests folder, where test971.pl and test1486.pl look (BL-2865). -->
    <ContentWithTargetPath Include="UpstreamTestData\docs\**;UpstreamTestData\include\**;UpstreamTestData\lib\**;UpstreamTestData\src\**" TargetPath="$([System.String]::Copy('%(RelativeDir)').Substring(17))%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
