<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
TFTP
no-host
</keywords>
</info>
# Expected output measured from real curl 8.22.0 (Schannel, WinLDAP) by running the same command line: exit code and
# -w text as pinned below.
# Upstream cases searched in Original/ for TFTP: every case with a tftp:// URL (test283 to test286, test332, test1007,
# test1009, test1049, test1093, test1094, test1099, test1238, test1242, test1243, test1453, test1462, test1538,
# test2002 to test2004, test271); none checks this URL or failure.

# Server-side
<reply>
</reply>

# Client-side
<client>
<name>
TFTP URL without a host is rejected
</name>
<command>
-s -w '%{exitcode}|%{errormsg}\n' tftp://
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<errorcode>
3
</errorcode>
<stdout>
3|URL rejected: No host present
</stdout>
</verify>
</testcase>