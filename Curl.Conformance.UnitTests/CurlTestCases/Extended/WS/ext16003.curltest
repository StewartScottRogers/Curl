<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
WebSockets
WebSockets request headers Basic auth
</keywords>
</info>

# The path has no digits: sws reads a path number over 10000 as a part number, so /%TESTNUMBER would not find this case's reply.
# Expected bytes: measured with Record-CurlExchange.ps1 against curl 8.22.0 (request.bin, stdout.bin, exit code 22,
# stderr "curl: (22) Refused WebSocket upgrade: and the status"). The random Sec-WebSocket-Key line is stripped.
# Upstream cases searched for overlap: test2300-test2304 and test2700-test2723 (all expect a 101 upgrade; none
# gets a refused upgrade, sets -H, -u, -I or -w).

# Server-side
<reply>
<data crlf="headers" nocheck="yes">
HTTP/1.1 401 Unauthorized
Content-Length: 0

</data>
</reply>

# Client-side
<client>
<features>
ws
</features>
<server>
http
</server>
<name>
ws:// upgrade request carries -H and -u headers, a 401 is refused
</name>
<command>
-H 'Origin: http://example.com' -u user:pass -w '%{http_code}\n' ws://%HOSTIP:%HTTPPORT/refused
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<strip>
^Sec-WebSocket-Key: .*
</strip>
<protocol crlf="headers" nocheck="yes">
GET /refused HTTP/1.1
Host: %HOSTIP:%HTTPPORT
Authorization: Basic dXNlcjpwYXNz
User-Agent: curl/%VERSION
Accept: */*
Upgrade: websocket
Sec-WebSocket-Version: 13
Origin: http://example.com
Connection: Upgrade

</protocol>
<stdout>
401
</stdout>
<errorcode>
22
</errorcode>
</verify>
</testcase>