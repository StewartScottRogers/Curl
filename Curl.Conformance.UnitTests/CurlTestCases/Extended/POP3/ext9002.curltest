<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
POP3
POP3S
URL
no-host
</keywords>
</info>
# Expected output measured from real curl 8.22.0 (Schannel, WinLDAP) by running the same command line: exit code and
# -w text as pinned below.
# Upstream cases searched in Original/ for POP3: test1319, test1407, test1462, test480, test850 to test894, test982,
# test985, test989, test993, test997 (none checks this URL or failure).

# Server-side
<reply>
</reply>

# Client-side
<client>
<name>
POP3S URL without a host is rejected
</name>
<command>
-s -w '%{exitcode}|%{errormsg}\n' pop3s://
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<errorcode>
3
</errorcode>
<stdout>
3|URL rejected: No host present
</stdout>
</verify>
</testcase>
