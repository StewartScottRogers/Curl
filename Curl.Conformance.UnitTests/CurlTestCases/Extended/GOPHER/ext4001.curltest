<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
GOPHER
empty selector
</keywords>
</info>

# Measured with real curl 8.22.0 against a loopback listener that records the bytes curl sends and
# answers "iHello<TAB>x<TAB>y<TAB>70" and ".", each ended CRLF: curl sent the selector shown below and
# then CRLF, and printed the reply unchanged. Upstream cases searched: test1200, 1201, 1202, 1203,
# 1272, 1563, 5028 (index, selector, query, IPv6, GOPHERS, redirect and header dump only).

# Server-side
<reply>
<data crlf="yes">
iHello	x	y	70
.
</data>
</reply>

# Client-side
<client>
<server>
gopher
</server>
<name>
Gopher URL with no path sends an empty selector
</name>
<command>
gopher://%HOSTIP:%GOPHERPORT
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<protocol crlf="yes">

</protocol>
</verify>
</testcase>
