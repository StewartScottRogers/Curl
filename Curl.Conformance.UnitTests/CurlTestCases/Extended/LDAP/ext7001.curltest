<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
LDAP
URL
no-host
</keywords>
</info>
# Expected output measured from real curl 8.22.0 (Schannel, WinLDAP) with Record-CurlExchange-style runs of the same
# command line: exit 3, message from -w.
# Upstream cases searched in Original/ for LDAP: test445, test1462, test1538 (none run an ldap:// transfer).

# Server-side
<reply>
</reply>

# Client-side
<client>
<name>
LDAP URL without a host is rejected
</name>
<command>
-s -w '%{exitcode}|%{errormsg}\n' ldap://
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<errorcode>
3
</errorcode>
<stdout>
3|URL rejected: No host present
</stdout>
</verify>
</testcase>