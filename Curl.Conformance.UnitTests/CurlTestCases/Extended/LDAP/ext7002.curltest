<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
LDAP
--proto
protocol-disabled
</keywords>
</info>
# Expected output measured from real curl 8.22.0 (Schannel, WinLDAP) with Record-CurlExchange-style runs of the same
# command line: exit 1, message from -w.
# Upstream cases searched in Original/ for LDAP: test445, test1462, test1538 (none run an ldap:// transfer).

# Server-side
<reply>
</reply>

# Client-side
<client>
<name>
LDAP disabled by --proto
</name>
<command>
-s -w '%{exitcode}|%{errormsg}\n' --proto -ldap ldap://%HOSTIP/dc=example
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<errorcode>
1
</errorcode>
<stdout>
1|Protocol "ldap" is disabled
</stdout>
</verify>
</testcase>