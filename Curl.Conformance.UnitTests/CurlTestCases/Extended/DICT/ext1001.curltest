<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
DICT
DICT lookup
</keywords>
</info>

# Measured with real curl 8.22.0 (Record-CurlExchange.ps1) against a loopback server that answers
# "220 dictserver <xnooptions> <msgid@msgid>" and "552 No matches", as the dict stand-in does.

# Server-side
<reply>
</reply>

# Client-side
<client>
<server>
dict
</server>
<features>
dict
</features>
<name>
DICT lookup with a database prints the server reply
</name>
<command>
dict://%HOSTIP:%DICTPORT/lookup:bar:fd-eng-lat
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<stdout mode="text">
220 dictserver <xnooptions> <msgid@msgid>
552 No matches
</stdout>
</verify>
</testcase>
