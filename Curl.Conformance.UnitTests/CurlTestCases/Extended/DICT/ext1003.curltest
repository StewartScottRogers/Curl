<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
DICT
DICT --write-out
</keywords>
</info>

# Measured with real curl 8.22.0 (Record-CurlExchange.ps1) against a loopback server that answers
# "220 dictserver <xnooptions> <msgid@msgid>" and "552 No matches", as the dict stand-in does.

# Server-side
<reply>
</reply>

# Client-side
<client>
<server>
dict
</server>
<features>
dict
</features>
<name>
DICT transfer size and scheme in --write-out
</name>
<command>
dict://%HOSTIP:%DICTPORT/d:basic -o %LOGDIR/ext%TESTNUMBER.out -w '%{size_download}|%{scheme}\n'
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<stdout mode="text">
57|dict
</stdout>
</verify>
</testcase>
