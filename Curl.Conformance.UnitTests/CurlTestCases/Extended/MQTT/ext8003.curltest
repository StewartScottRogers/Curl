<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
MQTT
URL
port
</keywords>
</info>
# Expected output measured from real curl 8.22.0 (Schannel, WinLDAP) by running the same command line: exit code and
# -w text as pinned below.
# Upstream cases searched in Original/ for MQTT: test1132, test1190 to test1196, test1198, test1199, test1916, test1917,
# test2109, test2200 to test2207, test3017, test3018, test445 (none checks this URL or connect failure).

# Server-side
<reply>
</reply>

# Client-side
<client>
<name>
MQTT URL with an out-of-range port is rejected
</name>
<command>
-s -w '%{exitcode}|%{errormsg}\n' mqtt://127.0.0.1:99999/x
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<errorcode>
3
</errorcode>
<stdout>
3|URL rejected: Port number was not a decimal number between 0 and 65535
</stdout>
</verify>
</testcase>
