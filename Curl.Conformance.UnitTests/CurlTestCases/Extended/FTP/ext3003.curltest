<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
FTP
write-out
scheme
url_effective
ftp-pasv
</keywords>
</info>
# Expected output measured from real curl 8.21.0 (Schannel) against a scripted loopback FTP server
# (a PowerShell stand-in answering USER, PASS, PWD, CWD, EPSV, TYPE, SIZE, RETR and QUIT).

# Server-side
<reply>
<data nocheck="yes">
line one
line two
</data>
</reply>

# Client-side
<client>
<server>
ftp
</server>
<name>
FTP download with --ftp-pasv and --write-out scheme and URL
</name>
<command>
-s --ftp-pasv -w '%{scheme}|%{url_effective}\n' ftp://%HOSTIP:%FTPPORT/test-3003/3003
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<protocol crlf="yes">
USER anonymous
PASS ftp@example.com
PWD
CWD test-%TESTNUMBER
EPSV
TYPE I
SIZE %TESTNUMBER
RETR %TESTNUMBER
QUIT
</protocol>
<stdout>
line one
line two
ftp|ftp://%HOSTIP:%FTPPORT/test-3003/3003
</stdout>
</verify>
</testcase>
