<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
SCP
SCP empty file
</keywords>
</info>

# Expected bytes: no SSH server could be recorded with Record-CurlExchange.ps1 (it runs curl against its own
# loopback listeners, not an sshd), so the output is what curl documents for a transfer: the downloaded bytes
# unchanged, then the --write-out text. Upstream cases searched for overlap: test600-test642, test1446,
# test1459, test1583, test1725 (none sets -w, an empty file, --max-filesize or a one-byte range).

# Server-side
<reply>
<data nocheck="yes">
</data>
</reply>

# Client-side
<client>
<server>
scp
</server>
<name>
SCP download of an empty file prints nothing and reports size 0
</name>
<command>
--key %LOGDIR/server/curl_client_key --pubkey %LOGDIR/server/curl_client_key.pub -u %USER: -w '%{size_download}\n' scp://%HOSTIP:%SSHPORT%SCP_PWD/%LOGDIR/file%TESTNUMBER.txt --insecure
</command>
<file name="%LOGDIR/file%TESTNUMBER.txt" nonewline="yes">
</file>
</client>

# Verify data after the test has been "shot"
<verify>
<stdout>
0
</stdout>
</verify>
</testcase>
