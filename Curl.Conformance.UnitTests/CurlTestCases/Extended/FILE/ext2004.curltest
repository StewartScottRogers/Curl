<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
FILE
write-out
</keywords>
</info>

<reply>
</reply>

# Client-side. Expected output measured from real curl 8.22.0 (Schannel build) on Windows, 2026-10-25.
<client>
<server>
file
</server>
<name>
--write-out size_download after a file:// transfer
</name>
<command option="no-include">
-w '[%{size_download}]' file://localhost%FILE_PWD/%LOGDIR/ext%TESTNUMBER.txt
</command>
<file name="%LOGDIR/ext%TESTNUMBER.txt">
1234567890
</file>
</client>

<verify>
<stdout nonewline="yes">
1234567890
[11]
</stdout>
</verify>
</testcase>
