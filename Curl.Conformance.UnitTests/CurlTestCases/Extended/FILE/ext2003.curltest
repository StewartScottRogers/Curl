<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
FILE
percent-encoding
</keywords>
</info>

<reply>
</reply>

# Client-side. Expected output measured from real curl 8.22.0 (Schannel build) on Windows, 2026-10-25.
<client>
<server>
file
</server>
<name>
percent-encoded space in a file:// path names the file with the space
</name>
<command option="no-include">
file://localhost%FILE_PWD/%LOGDIR/ext%TESTNUMBER%20x.txt
</command>
<file name="%LOGDIR/ext%TESTNUMBER x.txt">
hello
</file>
</client>

<verify>
<stdout>
hello
</stdout>
</verify>
</testcase>
