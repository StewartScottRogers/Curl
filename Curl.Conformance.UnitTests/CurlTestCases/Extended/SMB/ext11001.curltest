<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
SMB
SMB disabled
</keywords>
</info>

# The reference curl (8.22.0, Schannel build, measured 2026-10-26 for BL-3887) is built without SMB:
# curl -sS smb://127.0.0.1:20002/share/x exits 1 with curl: (1) Protocol "smb" is disabled, connecting
# nowhere, and Curl does the same (ADR-0829).

# Client-side
<client>
<server>
none
</server>
<name>
SMB download is refused as a disabled protocol
</name>
<command>
-sS smb://%HOSTIP:%SMBPORT/TESTS/%TESTNUMBER
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<errorcode>
1
</errorcode>
</verify>
</testcase>
