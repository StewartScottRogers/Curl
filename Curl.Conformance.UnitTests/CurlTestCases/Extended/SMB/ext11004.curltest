<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
SMB
SMB wrong share
</keywords>
</info>

# Expected bytes are the file the smb server serves from <reply><data>, as in upstream's SMB cases: the
# reference curl (8.22.0, Schannel build, Record-CurlExchange.ps1) is built without SMB, so no exchange
# could be recorded; curl's output for a downloaded file is those bytes unchanged.

# Server-side
<reply>
<data nocheck="yes">
</data>
</reply>

# Client-side
<client>
<server>
smb
</server>
<features>
smb
</features>
<name>
SMB tree connect to a share the server does not have fails
</name>
<command>
-u 'curltest:curltest' smb://%HOSTIP:%SMBPORT/NOSUCHSHARE/%TESTNUMBER
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<errorcode>
78
</errorcode>
</verify>
</testcase>
