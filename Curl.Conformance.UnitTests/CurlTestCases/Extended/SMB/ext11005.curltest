<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
SMB
SMB -o output file
</keywords>
</info>

# Expected bytes are the file the smb server serves from <reply><data>, as in upstream's SMB cases: the
# reference curl (8.22.0, Schannel build, Record-CurlExchange.ps1) is built without SMB, so no exchange
# could be recorded; curl's output for a downloaded file is those bytes unchanged, written to -o's file.

# Server-side
<reply>
<data nocheck="yes">
0123456789
</data>
</reply>

# Client-side
<client>
<server>
smb
</server>
<features>
smb
</features>
<name>
SMB download written to a file with -o
</name>
<command option="no-output">
-u 'curltest:curltest' smb://%HOSTIP:%SMBPORT/TESTS/%TESTNUMBER -o %LOGDIR/out
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<file name="%LOGDIR/out">
0123456789
</file>
</verify>
</testcase>
