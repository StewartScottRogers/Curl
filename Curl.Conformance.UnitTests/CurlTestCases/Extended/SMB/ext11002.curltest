<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
SMB
SMB download in a subdirectory
</keywords>
</info>

# Expected bytes are the file the smb server serves from <reply><data>, as in upstream's SMB cases: the
# reference curl (8.22.0, Schannel build, Record-CurlExchange.ps1) is built without SMB, so no exchange
# could be recorded; curl's output for a downloaded file is those bytes unchanged.

# Server-side
<reply>
<data nocheck="yes">
file in a subdirectory
</data>
</reply>

# Client-side
<client>
<server>
smb
</server>
<features>
smb
</features>
<name>
SMB download of a file in a subdirectory of the share
</name>
<command>
-u 'curltest:curltest' smb://%HOSTIP:%SMBPORT/TESTS/sub/dir/%TESTNUMBER
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<stdout>
file in a subdirectory
</stdout>
</verify>
</testcase>
