{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet sln:*)",
      "Bash(dotnet ef migrations list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File .claude/skills/task-board/task-board.ps1:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File .claude/skills/task-board/task-admin.ps1:*)",
      "Bash(pwsh -NoProfile -ExecutionPolicy Bypass -File .claude/skills/task-board/task-board.ps1:*)",
      "Bash(pwsh -NoProfile -ExecutionPolicy Bypass -File .claude/skills/task-board/task-admin.ps1:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)"
    ],
    "ask": [
      "Bash(dotnet add package:*)",
      "Bash(dotnet remove package:*)",
      "Bash(dotnet ef database update:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin HEAD:master:*)",
      "Bash(git merge:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push --force-with-lease:*)",
      "PowerShell(git push origin master:*)",
      "PowerShell(git push origin HEAD:master:*)",
      "PowerShell(git merge:*)"
    ],
    "deny": [
      "Read(./**/bin/**)",
      "Read(./**/obj/**)",
      "Read(./.vs/**)",
      "Read(/data/**)",
      "Edit(/data/**)",
      "Read(./**/appsettings.*.Local.json)",
      "Read(./**/*.pfx)",
      "Read(./**/*.snk)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v powershell >/dev/null 2>&1; then exec powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/guard-audit-paths.ps1; elif command -v pwsh >/dev/null 2>&1; then exec pwsh -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/guard-audit-paths.ps1; elif [ -n \"$CURL_DARK_FACTORY_LANE\" ]; then echo 'Refused by the audit guard: neither powershell nor pwsh is on PATH, so the guard cannot run.' >&2; exit 2; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v powershell >/dev/null 2>&1; then exec powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/format-cs.ps1; elif command -v pwsh >/dev/null 2>&1; then exec pwsh -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/format-cs.ps1; fi"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v powershell >/dev/null 2>&1; then exec powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/whisper-milestone.ps1; elif command -v pwsh >/dev/null 2>&1; then exec pwsh -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/whisper-milestone.ps1; fi",
            "async": true,
            "timeout": 180
          }
        ]
      }
    ]
  }
}
