<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Curl.Mcp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Packed as an MCP server the way Microsoft's mcpserver template does it (BL-2388): a .NET
    tool package of PackageType McpServer that `dnx Curl.Mcp` runs, one self-contained package
    per runtime identifier, with .mcp/server.json for the MCP registry. Its version is the
    version in .mcp/server.json; Curl.Mcp.UnitTests holds the two equal.
  -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <ToolCommandName>curl-mcp</ToolCommandName>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <PublishSelfContained>true</PublishSelfContained>
    <!--
      Native AOT is passed on the command line, -p:PublishAot=true, never set here (ADR-0599): AOT cannot
      cross-compile between operating systems, so with it a plain `dotnet pack` makes only the tool package and
      each runtime package needs `dotnet pack -r <rid>` on its own OS, as release.yml does. Without it,
      `dotnet pack` makes all seven self-contained packages on any OS, which ci.yml's mcp-pack job checks.
    -->
    <!-- Curl.Console is referenced as a library for its InProcessCurl, never run as its own executable. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <PackageId>Curl.Mcp</PackageId>
    <Version>0.1.0</Version>
    <Authors>Stewart Scott Rogers</Authors>
    <Description>An MCP server that runs curl for AI agents: Curl, the drop-in C# replacement for the curl command-line tool, served over standard input and output.</Description>
    <PackageTags>AI; MCP; server; stdio; curl</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/StewartScottRogers/Curl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/StewartScottRogers/Curl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Curl.Mcp.IntegrationTests" />
    <InternalsVisibleTo Include="Curl.Mcp.UnitTests" />
  </ItemGroup>

  <!-- The only project that takes the MCP SDK packages (ADR-0548). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <!-- For its public InProcessCurl, which the curl tool's runner adapter calls (BL-2382). -->
    <!-- Built runtime-agnostic, as a library, so each per-runtime pack needs no restore of it for that runtime. -->
    <ProjectReference Include="..\Curl.Console\Curl.Console.csproj" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\Curl.Mcp.UnitLibrary\Curl.Mcp.UnitLibrary.csproj" />
  </ItemGroup>

</Project>
