<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Curl.Conformance.UnitTests" />
    <!-- Gap/Tools/Expand-UpstreamCase.cs (BL-1730) reuses the harness's command line and part bodies. -->
    <InternalsVisibleTo Include="Expand-UpstreamCase" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Curl.Protocol.Abstractions.UnitLibrary\Curl.Protocol.Abstractions.UnitLibrary.csproj" />
    <!-- A <tool> libtest case runs its ported program over Libcurl (BL-2556). -->
    <ProjectReference Include="..\Curl.Conformance.LibTest.UnitLibrary\Curl.Conformance.LibTest.UnitLibrary.csproj" />
    <!-- A unittest case runs its ported unit program (BL-2841, ADR-0711). -->
    <ProjectReference Include="..\Curl.Conformance.UnitProgram.UnitLibrary\Curl.Conformance.UnitProgram.UnitLibrary.csproj" />
    <!-- curl-config's answers stand in for ../curl-config in test1013.pl and test1022.pl (ADR-0712). -->
    <ProjectReference Include="..\Curl.Config.UnitLibrary\Curl.Config.UnitLibrary.csproj" />
    <!-- UpstreamManagenScript runs Curl's manual page generator for cases 1705 and 1706 (BL-2881). -->
    <ProjectReference Include="..\Curl.Cli.UnitLibrary\Curl.Cli.UnitLibrary.csproj" />
    <!-- Script interpretations read Libcurl's tables where upstream's libcurl table checks read curl.h and version.c (BL-2990). -->
    <ProjectReference Include="..\Libcurl\Libcurl.csproj" />
    <!-- Curl's own TLS 1.3 server answers a TLS 1.3-only client where SslStream cannot (macOS; GF-0092). -->
    <ProjectReference Include="..\Curl.Tls.UnitLibrary\Curl.Tls.UnitLibrary.csproj" />
  </ItemGroup>

</Project>
