<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Curl.Original.Protocol.Ssh.UnitLibrary\Curl.Original.Protocol.Ssh.UnitLibrary.csproj" />
  </ItemGroup>

  <!--
    The unit tests' fakes the Pageant test uses, linked rather than referenced: a
    ProjectReference to Curl.Original.Protocol.Ssh.UnitTests would bring a second TestDiagnostics.
    The fakes take their SSH namespaces from the unit tests' one-per-namespace global
    using files, so those are linked too.
  -->
  <ItemGroup>
    <Compile Include="..\Curl.Original.Protocol.Ssh.UnitTests\GlobalUsings\*.cs" LinkBase="GlobalUsings" />
    <Compile Include="..\Curl.Ssh.UnitTests\Fakes\InMemorySshAgent.cs" Link="Fakes\InMemorySshAgent.cs" />
    <Compile Include="..\Curl.Ssh.UnitTests\Fakes\SshTestEncoding.cs" Link="Fakes\SshTestEncoding.cs" />
    <Compile Include="..\Curl.Ssh.UnitTests\Fakes\TestUserKeys.cs" Link="Fakes\TestUserKeys.cs" />
  </ItemGroup>

</Project>
