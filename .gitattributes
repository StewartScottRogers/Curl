###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

# Shell scripts run on Linux and macOS, where CRLF breaks them.
*.sh text eol=lf

# The upstream case ratchet is one case number per line, read as a set, and dark factory
# lanes add to it at once: a merge or rebase keeps both sides' lines (ADR-0689).
Curl.Conformance.UnitTests/PassingUpstreamCases.txt merge=union

# Extension projects are added to Curl.slnx as one order-free line each under one marker comment; two
# branches adding a line at once keep both (ADR-1003).
Curl.slnx merge=union

###############################################################################
# Set default behavior for command prompt diff.
#
# This is need for earlier builds of msysgit that does not have it on by
# default for csharp files.
# Note: This is only used by command line
###############################################################################
#*.cs     diff=csharp

###############################################################################
# Set the merge driver for project and solution files
#
# Merging from the command prompt will add diff markers to the files if there
# are conflicts (Merging from VS is not affected by the settings below, in VS
# the diff markers are never inserted). Diff markers may cause the following 
# file extensions to fail to load in VS. An alternative would be to treat
# these files as binary and thus will always conflict and require user
# intervention with every merge. To do so, just uncomment the entries below
###############################################################################
#*.sln       merge=binary
#*.csproj    merge=binary
#*.vbproj    merge=binary
#*.vcxproj   merge=binary
#*.vcproj    merge=binary
#*.dbproj    merge=binary
#*.fsproj    merge=binary
#*.lsproj    merge=binary
#*.wixproj   merge=binary
#*.modelproj merge=binary
#*.sqlproj   merge=binary
#*.wwaproj   merge=binary

###############################################################################
# behavior for image files
#
# image files are treated as binary by default.
###############################################################################
#*.jpg   binary
#*.png   binary
#*.gif   binary

###############################################################################
# diff behavior for common document formats
# 
# Convert binary document formats to text before diffing them. This feature
# is only available from the command line. Turn it on by uncommenting the 
# entries below.
###############################################################################
#*.doc   diff=astextplain
#*.DOC   diff=astextplain
#*.docx  diff=astextplain
#*.DOCX  diff=astextplain
#*.dot   diff=astextplain
#*.DOT   diff=astextplain
#*.pdf   diff=astextplain
#*.PDF   diff=astextplain
#*.rtf   diff=astextplain
#*.RTF   diff=astextplain
# Registration tables listed in Tasks/SharedListFiles.txt: one entry per line, so tasks
# that each add a line merge cleanly side by side.
Curl.Conformance.UnitLibrary/Upstream*Features.cs merge=union
Curl.Conformance.UnitLibrary/UpstreamPlatformFeatureTable.cs merge=union
Curl.Conformance.UnitProgram.UnitLibrary/UnitPrograms.*.cs merge=union
Documentation/Planning/Decisions/README.md merge=union

# Extended curltest cases carry file and expected-output parts whose bytes the runner compares,
# so a checkout must not turn their line feeds into CRLF on Windows.
Curl.Conformance.UnitTests/CurlTestCases/Extended/**/*.curltest text eol=lf
Curl.Extension.Composition.UnitLibrary/ExtensionCatalogue.cs merge=union
Curl.Extension.Composition.UnitLibrary/ExtensionOptionCatalogue.cs merge=union
Curl.Extension.Composition.UnitLibrary/ExtensionDescriptionCatalogue.cs merge=union
Curl.Extension.Composition.UnitLibrary/ExtensionTransferHookCatalogue.cs merge=union
Curl.Extension.Composition.UnitLibrary/ExtensionConnectionHookCatalogue.cs merge=union
Curl.Extension.Composition.UnitLibrary/ExtensionSchemeHookCatalogue.cs merge=union
Curl.Extension.Composition.UnitLibrary/ExtensionResolverHookCatalogue.cs merge=union
Curl.Extension.Composition.UnitLibrary/ExtensionCertificateCheckHookCatalogue.cs merge=union
Curl.Extension.Composition.UnitLibrary/ExtensionArgumentExpanderCatalogue.cs merge=union
