<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Drops onto PATH as curl.exe, so scripts cannot tell the difference. -->
    <AssemblyName>curl</AssemblyName>
    <RootNamespace>Curl.Console</RootNamespace>
    <!--
      Native ahead-of-time is the shipping configuration and the default, so
      `dotnet publish` produces the binary that ships rather than one that only
      resembles it. `dotnet build` and `dotnet test` are unaffected - PublishAot
      only takes effect on publish.

      It needs the MSVC linker from the "Desktop development with C++" workload,
      and it needs vswhere.exe on PATH to find it. Without vswhere the link step
      fails with MSB3073 and a confusing "'vswhere.exe' is not recognized", so add
      it once per shell or machine:
          C:\Program Files (x86)\Microsoft Visual Studio\Installer
      A machine that genuinely cannot link native code opts out per publish:
          dotnet publish Curl.Console -c Release -p:PublishAot=false
      IsAotCompatible stays on for every production project and is checked by the
      VerifyAotCompatibility target in Directory.Build.props, so incompatible code
      is caught at build time rather than here.
    -->
    <PublishAot Condition=" '$(PublishAot)' == '' ">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      A smaller native binary costs less to scan on each launch under Windows Defender's
      on-access scanning (AF-0048). Together these take curl.exe from 17.0 MB to 13.7 MB;
      the hand-built crypto and a loopback TLS GET stay within 5% of their speed, and
      curl never prints a stack trace, so no output changes (BL-1749, ADR-0434).
    -->
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <!-- The source-generated LibraryImport marshalling of NativeExtendedAttributeWriter (ADR-0320). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    ILC links the runtime's COM calls (CoCreateGuid, CoInitializeEx, CoWaitForMultipleHandles
    and four more) against ole32.lib, and ole32.dll statically imports user32 and gdi32, which
    load gdi32full, win32u and imm32 too: about 1.1 MB of working set real curl.exe never maps.
    mincore.lib binds the same functions to the api-ms-win-core-com API sets, which combase.dll
    serves without user32 (BL-1290, ADR-0402). The link step reads @(LinkerArg), which
    SetupOSSpecificProps has already built from @(SdkNativeLibrary), so the swap is made there.
  -->
  <Target Name="LinkComThroughApiSetsNotOle32"
          AfterTargets="SetupOSSpecificProps"
          Condition=" $(RuntimeIdentifier.StartsWith('win')) ">
    <ItemGroup>
      <LinkerArg Remove="&quot;ole32.lib&quot;" />
      <LinkerArg Include="&quot;mincore.lib&quot;" />
    </ItemGroup>
  </Target>

  <!--
    ILC imports ncrypt, Secur32, ADVAPI32, CRYPT32 and IPHLPAPI statically, so Windows maps them
    (and NTASN1, msvcrt and more behind them) at startup even for a plain http:// GET, which calls
    none of them: about 0.9 MB of peak working set. Delay-loading maps each one on its first call
    instead - a TLS handshake, Negotiate, an interface lookup (BL-1682, AF-0063, ADR-0431).
  -->
  <Target Name="DelayLoadDllsPlainTransfersNeverCall"
          AfterTargets="SetupOSSpecificProps"
          Condition=" $(RuntimeIdentifier.StartsWith('win')) ">
    <ItemGroup>
      <LinkerArg Include="delayimp.lib" />
      <LinkerArg Include="/DELAYLOAD:ncrypt.dll;/DELAYLOAD:Secur32.dll;/DELAYLOAD:ADVAPI32.dll;/DELAYLOAD:CRYPT32.dll;/DELAYLOAD:IPHLPAPI.DLL" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Curl.Console.IntegrationTests" />
    <InternalsVisibleTo Include="Curl.Console.UnitTests" />
    <InternalsVisibleTo Include="Curl.Conformance.UnitTests" />
  </ItemGroup>

