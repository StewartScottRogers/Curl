<Project>

  <!--
    Build settings for the gap analysis office's C# file-based apps in this folder, such as
    Measure-UpstreamCases.cs, which run through "dotnet run file". Because this file exists,
    MSBuild stops here and never imports the repository root's Directory.Build.props
    into the apps, whose gates (CA1502 via CodeMetricsConfig.txt, XML documentation, the
    AOT check) are written for the product's projects, not for measuring tools. The
    product projects an app references keep the root's settings: they live outside this folder.

    No project in Curl.slnx lives under Gap/Tools, so nothing here reaches the solution.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Measuring tools, never published: no native AOT compile on first run. -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>

</Project>
