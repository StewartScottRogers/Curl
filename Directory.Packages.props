<Project>
  <!--
    Central package management: every version lives here, and no PackageReference in
    a project file may carry a Version attribute (CLAUDE.md).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!--
    Microsoft's MSTest meta-package, which carries the framework, the adapter and the
    test platform. It is what `dotnet new mstest` produces on SDK 10, so a test project
    generated by the template needs no edit to match this file.
  -->
  <ItemGroup>
    <PackageVersion Include="MSTest" Version="4.5.1" />
  </ItemGroup>
  <!--
    Microsoft's C# MCP SDK and the generic host it runs in, approved by Stewart on
    2026-10-15 for Curl.Mcp alone (ADR-0548). No other project may reference them.
    Nothing else is approved - see CLAUDE.md.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>
</Project>
