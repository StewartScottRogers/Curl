    <File Path=".github/gource/Directory.Build.props" />
    <File Path=".github/gource/Directory.Build.targets" />
    <File Path=".github/gource/Directory.Packages.props" />
    <File Path=".github/gource/make-captions.cs" />
    <File Path=".github/gource/make-log.cs" />
    <File Path=".github/gource/make-master-playlist.cs" />
    <File Path=".github/gource/make-stats.cs" />
    <File Path=".github/gource/serve.cs" />
