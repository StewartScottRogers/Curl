  <!--
    Each Curl.Conformance.<Part>.* project sits in /Conformance/<Part>/ with its tests, the
    harness itself (Curl.Conformance.UnitLibrary) in /Conformance/Harness/, and each
    Curl.Original.Protocol.<Name>.* project in /Original/Protocols/<Name>/, with Curl.Protocol.Abstractions
    in /Protocols/Abstractions/ (ADR-0731, ADR-1176). Every other area sits
    with its tests in /<Group>/<Area>/: Hosts, CommandLine, Transfer, Wire and Security.
  -->
  <Folder Name="/Conformance/" />
  <Folder Name="/Conformance/Differential/">
    <Project Path="Curl.Conformance.Differential.IntegrationTests/Curl.Conformance.Differential.IntegrationTests.csproj" />
    <Project Path="Curl.Conformance.Differential.UnitLibrary/Curl.Conformance.Differential.UnitLibrary.csproj" />
