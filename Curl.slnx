<Solution>

  <!--
    Curl.slnx - XML solution format (.slnx), readable and merge-friendly in a way
    the legacy .sln never was. Requires .NET SDK 9.0.200+ or Visual Studio 17.13+;
    this repo is on SDK 10.0.401.

    Documentation, Tasks and .claude/Claude are shared projects: they carry no build output, so they add
    nothing to build time while keeping the product and planning documents
    visible in Solution Explorer.
  -->

  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".gitattributes" />
    <File Path=".gitignore" />
    <File Path="CodeMetricsConfig.txt" />
    <File Path="DOWNLOAD.md" />
    <File Path="GitHub-Curl-README.url" />
    <File Path="hrdrClaudeNative.cmd" />
    <File Path="LICENSE.txt" />
    <File Path="README.md" />
    <File Path="RunClaude.cmd" />
  </Folder>

  <Folder Name="/Scripts/">
    <File Path="RunClaude.cmd" />
    <File Path="hrdrClaudeNative.cmd" />
    <File Path="Measure-CodeQuality.ps1" />
    <File Path="RunDarkFactory.ps1" />
    <File Path="RunDarkFactory.cmd" />
    <File Path=".github/gource/make-captions.py" />
    <File Path=".github/gource/make-log.py" />
    <File Path=".github/gource/make-master-playlist.py" />
    <File Path=".github/gource/make-stats.py" />
    <File Path=".github/gource/render.sh" />
    <File Path=".github/gource/site/index.html" />
    <File Path=".github/workflows/gource.yml" />
    <File Path=".github/workflows/ci.yml" />
    <File Path=".github/workflows/release.yml" />
    <File Path="install.ps1" />
    <File Path="install.sh" />
  </Folder>
  <Project Path="Curl.Authentication.UnitLibrary/Curl.Authentication.UnitLibrary.csproj" />
  <Project Path="Curl.Authentication.UnitTests/Curl.Authentication.UnitTests.csproj" />
