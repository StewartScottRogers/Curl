    <File Path="DarkFactory/ModelChoice.ps1" />
    <File Path="DarkFactory/OutOfTokens.ps1" />
    <File Path="DarkFactory/Park.ps1" />
    <File Path="DarkFactory/Prompts.ps1" />
    <File Path="DarkFactory/Requeue.ps1" />
    <File Path="DarkFactory/Restart.ps1" />
    <File Path="DarkFactory/Setup.ps1" />
    <File Path="DarkFactory/ShiftBranch.ps1" />
