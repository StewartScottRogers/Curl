  <!-- Extended: what Curl adds beyond upstream curl, kept apart from curl's own protocols in /Original/ (ADR-0999, ADR-1178):
       option extensions in /Extended/Features/, extensions that serve their own URL scheme in /Extended/Protocols/. -->
  <Folder Name="/Extended/" />
  <Folder Name="/Extended/Abstractions/">
    <Project Path="Curl.Extension.Abstractions.UnitLibrary/Curl.Extension.Abstractions.UnitLibrary.csproj" />
    <Project Path="Curl.Extension.Abstractions.UnitTests/Curl.Extension.Abstractions.UnitTests.csproj" />
  </Folder>
  <Folder Name="/Extended/Composition/">
    <Project Path="Curl.Extension.Composition.UnitLibrary/Curl.Extension.Composition.UnitLibrary.csproj" />
    <Project Path="Curl.Extension.Composition.UnitTests/Curl.Extension.Composition.UnitTests.csproj" />
  </Folder>
  <Folder Name="/Extended/Features/" />
  <Folder Name="/Extended/Protocols/" />
  <!-- A new extension adds ONE line directly below this comment: a single-line <Folder Name="/Extended/Features/<Name>/"> (/Extended/Protocols/<Name>/ for an extension that serves its own URL scheme, ADR-1177) holding its UnitLibrary and UnitTests <Project/> elements. One line, so merge=union keeps two branches' lines whole (ADR-1003). -->
  <Folder Name="/Extended/Features/SshJump/"><Project Path="Curl.Extension.SshJump.UnitLibrary/Curl.Extension.SshJump.UnitLibrary.csproj" /><Project Path="Curl.Extension.SshJump.UnitTests/Curl.Extension.SshJump.UnitTests.csproj" /></Folder>
  <Folder Name="/Extended/Features/StructuredFields/"><Project Path="Curl.Extension.StructuredFields.UnitLibrary/Curl.Extension.StructuredFields.UnitLibrary.csproj" /><Project Path="Curl.Extension.StructuredFields.UnitTests/Curl.Extension.StructuredFields.UnitTests.csproj" /></Folder>
