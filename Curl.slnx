  <!-- A new extension adds ONE line directly below this comment: a single-line <Folder Name="/Extensions/<Name>/"> holding its UnitLibrary and UnitTests <Project/> elements. One line, so merge=union keeps two branches' lines whole (ADR-1003). -->
  <Folder Name="/Extensions/WebDavTools/"><Project Path="Curl.Extension.WebDavTools.UnitLibrary/Curl.Extension.WebDavTools.UnitLibrary.csproj" /><Project Path="Curl.Extension.WebDavTools.UnitTests/Curl.Extension.WebDavTools.UnitTests.csproj" /></Folder>
